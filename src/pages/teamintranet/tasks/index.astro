---
/**
 * The work list — every task, with the file attached to it.
 *
 * WHY THIS REPLACES THE PROJECT PICKER ON THE UPLOAD PAGE.
 *
 * A cost report belongs to a task, not a project. The Bond Planning job is
 * one project carrying nine tasks — three schools across schematic design,
 * design development and construction documents — and four of the pilot
 * reports belong to it. Asked to choose a project for those four, there is no
 * answer that tells them apart.
 *
 * The upload page asked anyway, from a dropdown capped at 500 of 1,874
 * projects. Everything alphabetically after "Cu" was simply absent, so for
 * roughly three-quarters of jobs the right project could not be chosen and
 * the person typed a name instead — which created a new project. The orphans
 * were not an edge case, they were the normal outcome.
 *
 * Choosing a row here attaches the file to a deliverable that already exists.
 * Nothing is created, so nothing can be orphaned, and no one has to identify
 * a project from a list at all.
 *
 * THE DEFAULT FILTER MIRRORS THE AIRTABLE VIEW this was modelled on: Phase II
 * is Complete, due within the past year. That is 398 tasks here against 401
 * in Airtable — close enough to be sync timing, and shown as a count so the
 * difference is visible rather than assumed away.
 */
import IntranetLayout from '../../../layouts/IntranetLayout.astro';
import { listTasks, type TaskRow } from '../../../lib/intranet/tasks.ts';
import {
  filterTasks,
  parseTaskSort,
  sortTasks,
  workflowTone,
  type TaskSortKey,
} from '../../../lib/intranet/task-sort.ts';

export const prerender = false;

const params = Astro.url.searchParams;
const q = (params.get('q') ?? '').trim();

// `all` widens each filter rather than removing the control, so the page can
// always say what it is showing. A filter you cannot see is the same problem
// as a cap you cannot see.
const workflowParam = params.get('workflow') ?? 'Complete';
const windowParam = params.get('window') ?? '365';
const fileParam = params.get('file') ?? 'all';

const workflow = workflowParam === 'all' ? null : workflowParam;
const dueWithinDays = windowParam === 'all' ? null : Number(windowParam) || 365;
const hasFile = fileParam === 'yes' ? true : fileParam === 'no' ? false : null;

let tasks: TaskRow[] = [];
let taskError = '';
try {
  tasks = await listTasks(Astro.cookies, Astro.request, { workflow, dueWithinDays, hasFile });
} catch (err) {
  taskError = err instanceof Error ? err.message : String(err);
}

const { sort, dir } = parseTaskSort(params.get('sort'), params.get('dir'));
const matched = filterTasks(tasks, q);
const shown = sortTasks(matched, sort, dir);

const withFile = tasks.filter((t) => t.hasFile).length;
const withoutDue = tasks.filter((t) => t.dueDate === null).length;

const ariaSort = (key: TaskSortKey) =>
  sort === key ? ((dir === 'asc' ? 'ascending' : 'descending') as const) : ('none' as const);

/** Carries every control so changing one never silently resets another. */
function href(overrides: Record<string, string>): string {
  const p = new URLSearchParams();
  if (q) p.set('q', q);
  p.set('workflow', workflowParam);
  p.set('window', windowParam);
  p.set('file', fileParam);
  p.set('sort', sort);
  p.set('dir', dir);
  for (const [k, v] of Object.entries(overrides)) p.set(k, v);
  return `?${p.toString()}`;
}

const sortHref = (key: TaskSortKey) =>
  href({ sort: key, dir: sort === key && dir === 'asc' ? 'desc' : 'asc' });

const COLUMNS: Array<{ key: TaskSortKey; label: string }> = [
  { key: 'title', label: 'Task' },
  { key: 'project', label: 'Project / number' },
  { key: 'client', label: 'Client' },
  { key: 'pm', label: 'Estimator' },
  { key: 'due', label: 'Due' },
  { key: 'workflow', label: 'Workflow' },
  { key: 'file', label: 'Cost report' },
];

const WORKFLOW_CHOICES = [
  'Complete',
  'Draft Delivered',
  'Quality Control',
  'Report / Takeoff Development',
  'Docs Received - Assigned',
  'Docs Received - UNASSIGNED',
];
---

<IntranetLayout
  title="Work List"
  crumb="Work List"
  section="tasks"
  meta={[`${tasks.length} tasks`, `${withFile} with a cost report`]}
>
  <section class="panel">
    <h2>Work list</h2>
    <p class="sub">
      Every task, with the cost report attached to it. Upload from the row — the file
      attaches to that task, so there is nothing to pick and no project to create.
    </p>

    {
      taskError ? (
        <p class="err">
          <b>The work list could not be loaded.</b>
          <br />
          <code>{taskError}</code>
        </p>
      ) : (
        <>
          <form method="GET" class="searchrow">
            <input
              type="search"
              name="q"
              value={q}
              placeholder="Task, project, client, estimator, or fee proposal number"
              aria-label="Filter tasks"
            />
            <input type="hidden" name="workflow" value={workflowParam} />
            <input type="hidden" name="window" value={windowParam} />
            <input type="hidden" name="file" value={fileParam} />
            <input type="hidden" name="sort" value={sort} />
            <input type="hidden" name="dir" value={dir} />
            <button type="submit">Filter</button>
            {q ? <a href={href({ q: '' })}>Clear</a> : null}
          </form>

          <div class="filterbar">
            <span class="flabel">Workflow</span>
            <a href={href({ workflow: 'all' })} class={workflowParam === 'all' ? 'on' : undefined}>
              any
            </a>
            {WORKFLOW_CHOICES.map((w) => (
              <a href={href({ workflow: w })} class={workflowParam === w ? 'on' : undefined}>
                {w}
              </a>
            ))}
          </div>

          <div class="filterbar">
            <span class="flabel">Due</span>
            {[
              ['90', 'past 90 days'],
              ['365', 'past year'],
              ['1095', 'past 3 years'],
              ['all', 'any date'],
            ].map(([v, label]) => (
              <a href={href({ window: v })} class={windowParam === v ? 'on' : undefined}>
                {label}
              </a>
            ))}
            <span class="flabel">Report</span>
            {[
              ['all', 'either'],
              ['yes', 'uploaded'],
              ['no', 'not yet'],
            ].map(([v, label]) => (
              <a href={href({ file: v })} class={fileParam === v ? 'on' : undefined}>
                {label}
              </a>
            ))}
          </div>

          <p class="sub">
            {shown.length === tasks.length
              ? `${tasks.length} tasks`
              : `${shown.length} of ${tasks.length} tasks`}
            {withFile ? ` · ${withFile} with a cost report` : ''}
            {/* Said out loud because the date filter excludes them, and a
                count that quietly shrinks is the bug this page replaces. */}
            {windowParam !== 'all' && withoutDue
              ? ` · ${withoutDue} shown have no due date`
              : ''}
          </p>

          {shown.length === 0 ? (
            <p class="sub">
              {tasks.length === 0
                ? 'No tasks match those filters. Widen the workflow or date range above — this is a filter result, not an empty mirror.'
                : 'Nothing matches that search.'}
            </p>
          ) : (
            <table class="grid resizable" id="tasktable">
              <thead>
                <tr>
                  {COLUMNS.map((c) => (
                    <th aria-sort={ariaSort(c.key)} data-col={c.key}>
                      <a href={sortHref(c.key)} class={sort === c.key ? 'sorted' : undefined}>
                        {c.label}
                        <span class="arrow" aria-hidden="true">
                          {sort === c.key ? (dir === 'asc' ? '▲' : '▼') : '↕'}
                        </span>
                      </a>
                      {/* Separator role, not a button: it adjusts a value
                          rather than performing an action, and that is what
                          lets arrow keys work without hijacking Enter. */}
                      <span
                        class="grip"
                        role="separator"
                        aria-orientation="vertical"
                        aria-label={`Resize ${c.label} column`}
                        tabindex="0"
                      />
                    </th>
                  ))}
                  <th><span class="vh">Upload</span></th>
                </tr>
              </thead>
              <tbody>
                {shown.map((t) => (
                  <tr>
                    <td>
                      <div class="tasktitle">{t.title}</div>
                      <div class="chips">
                        {/* Chips, never parsed: this field also carries the
                            billing arrangement — On-Call, Hourly, Pro Bono. */}
                        {t.taskNumber.map((n) => (
                          <span class="chip task">{n}</span>
                        ))}
                        {t.taskType.map((n) => (
                          <span class="chip kind">{n}</span>
                        ))}
                      </div>
                    </td>
                    <td>
                      {t.projectName ?? <i class="none">no project</i>}
                      {t.taskFeeProposal ? (
                        <div class="fp">{t.taskFeeProposal}</div>
                      ) : t.projectFeeProposal ? (
                        <div class="fp">{t.projectFeeProposal}</div>
                      ) : null}
                    </td>
                    <td>{t.clients.length ? t.clients.join(', ') : <i class="none">none</i>}</td>
                    <td>
                      {t.projectManagers.length ? (
                        t.projectManagers.join(', ')
                      ) : (
                        <i class="none">none</i>
                      )}
                    </td>
                    <td>{t.dueDate ?? <i class="none">none</i>}</td>
                    <td>
                      {t.workflow ? (
                        <span class={`chip wf-${workflowTone(t.workflow)}`}>{t.workflow}</span>
                      ) : (
                        <i class="none">none</i>
                      )}
                    </td>
                    <td>
                      {t.hasFile ? (
                        <span class="chip green">{t.ingestStatus}</span>
                      ) : (
                        <i class="none">not uploaded</i>
                      )}
                    </td>
                    <td class="actions">
                      {t.folderLink ? (
                        <a href={t.folderLink} target="_blank" rel="noreferrer noopener">
                          Folder
                        </a>
                      ) : null}
                      {/* No Replace button: there is no UPDATE policy on
                          storage.objects, so overwriting an object fails, and
                          offering a button that cannot work is worse than
                          offering none. sign.ts refuses this case explicitly
                          rather than handing back a URL that dies in the
                          browser. */}
                      {t.hasFile ? (
                        <span class="sub">uploaded</span>
                      ) : (
                        <a class="btn" href={`/teamintranet/documents/?task=${t.id}`}>
                          Upload
                        </a>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </>
      )
    }
  </section>
</IntranetLayout>

<script is:inline>
  (function () {
    var table = document.getElementById('tasktable');
    if (!table) return;

    var KEY = 'dcw-tasks-colwidths';
    var MIN = 70;

    function load() {
      try { return JSON.parse(localStorage.getItem(KEY) || '{}') || {}; }
      catch (e) { return {}; }
    }
    function save(w) {
      try { localStorage.setItem(KEY, JSON.stringify(w)); } catch (e) { /* blocked */ }
    }

    var widths = load();
    var heads = table.querySelectorAll('th[data-col]');

    // table-layout:fixed only once widths exist. Left to auto, the browser
    // ignores a width set on one column and redistributes the rest, so the
    // column you dragged snaps back and the others move instead.
    function apply() {
      var any = false;
      for (var i = 0; i < heads.length; i++) {
        var key = heads[i].getAttribute('data-col');
        if (widths[key]) { heads[i].style.width = widths[key] + 'px'; any = true; }
      }
      table.style.tableLayout = any ? 'fixed' : '';
    }
    apply();

    function startWidth(th) {
      var key = th.getAttribute('data-col');
      return widths[key] || th.getBoundingClientRect().width;
    }

    function setWidth(th, px) {
      var key = th.getAttribute('data-col');
      widths[key] = Math.max(MIN, Math.round(px));
      apply();
    }

    for (var i = 0; i < heads.length; i++) {
      (function (th) {
        var grip = th.querySelector('.grip');
        if (!grip) return;

        grip.addEventListener('pointerdown', function (ev) {
          ev.preventDefault();
          // Freeze every column at its rendered width before the first move.
          // Otherwise switching to fixed layout mid-drag reflows all of them
          // at once and the whole table jumps under the cursor.
          for (var j = 0; j < heads.length; j++) {
            var k = heads[j].getAttribute('data-col');
            if (!widths[k]) widths[k] = Math.round(heads[j].getBoundingClientRect().width);
          }
          var from = ev.clientX;
          var base = startWidth(th);
          grip.setPointerCapture(ev.pointerId);
          document.body.style.cursor = 'col-resize';
          document.body.style.userSelect = 'none';

          function move(e) { setWidth(th, base + (e.clientX - from)); }
          function up(e) {
            grip.releasePointerCapture(e.pointerId);
            grip.removeEventListener('pointermove', move);
            grip.removeEventListener('pointerup', up);
            document.body.style.cursor = '';
            document.body.style.userSelect = '';
            save(widths);
          }
          grip.addEventListener('pointermove', move);
          grip.addEventListener('pointerup', up);
        });

        // Keyboard: a drag handle reachable only by mouse is not reachable by
        // everyone. Arrows nudge, Home resets this column.
        grip.addEventListener('keydown', function (ev) {
          var step = ev.shiftKey ? 40 : 10;
          if (ev.key === 'ArrowLeft') { setWidth(th, startWidth(th) - step); }
          else if (ev.key === 'ArrowRight') { setWidth(th, startWidth(th) + step); }
          else if (ev.key === 'Home') { delete widths[th.getAttribute('data-col')]; apply(); }
          else return;
          ev.preventDefault();
          save(widths);
        });

        grip.addEventListener('dblclick', function (ev) {
          ev.preventDefault();
          delete widths[th.getAttribute('data-col')];
          apply();
          save(widths);
        });
      })(heads[i]);
    }
  })();
</script>

<style>
  /* Only what the global stylesheet does not already provide. Colours come
     from the theme variables in src/styles/intranet.css so this page follows
     light and dark mode and any future palette change — the first draft used
     `currentColor` for borders, which ignored the theme and read as heavy
     grey boxes that matched nothing else in the intranet. */
  .filterbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.5rem;
    margin: 0.5rem 0;
  }
  .flabel {
    font-family: var(--brand);
    font-size: 0.63rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--muted);
    margin-right: 0.15rem;
  }
  .filterbar a {
    font-size: 0.74rem;
    padding: 0.14rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: var(--paper);
    color: var(--body);
    text-decoration: none;
  }
  .filterbar a:hover {
    border-color: var(--blue);
    color: var(--blue);
  }
  .filterbar a.on {
    background: var(--blue);
    border-color: var(--blue);
    color: #fff;
    font-weight: 600;
  }

  .tasktitle {
    font-weight: 500;
    color: var(--ink);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-top: 0.3rem;
  }
  /* .chip itself is global; these are the two tones this page needs. */
  .chip.task {
    color: var(--blue);
    background: var(--sunk);
    border-color: var(--line-2);
  }
  .chip.kind {
    color: var(--muted);
    background: transparent;
    border-color: var(--line);
  }

  .fp {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--muted);
    margin-top: 0.15rem;
  }
  .actions {
    white-space: nowrap;
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  /* Resize grips. The header cell is the positioning context; the grip sits
     on its right edge, slightly wider than it looks so it is grabbable
     without being fiddly. */
  .grid.resizable th { position: relative; }
  .grid.resizable th:last-child .grip { display: none; }
  .grip {
    position: absolute;
    top: 0;
    right: -4px;
    width: 9px;
    height: 100%;
    cursor: col-resize;
    touch-action: none;
    z-index: 1;
  }
  .grip::after {
    content: '';
    position: absolute;
    top: 20%;
    bottom: 20%;
    left: 4px;
    width: 1px;
    background: var(--line-2);
  }
  .grip:hover::after,
  .grip:focus-visible::after {
    background: var(--blue);
    top: 0;
    bottom: 0;
    width: 2px;
  }
  .grip:focus-visible { outline: none; }

  /* Fixed layout truncates rather than wraps, so a dragged-narrow column
     stays narrow instead of growing taller. The title cell is exempt — it is
     the one people need to read in full. */
  .grid.resizable td { overflow: hidden; text-overflow: ellipsis; }
  .grid.resizable td .tasktitle { white-space: normal; }

  .vh {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
</style>
