# DCW team intranet — copy to `.env` and fill in.
# `.env` is gitignored. Never commit real keys.
# Full walkthrough: docs/team-intranet/SETUP.md

# ---------------------------------------------------------------------------
# Master switch. Without this, /teamintranet returns 404 everywhere, so an
# accidental merge cannot publish an internal tool onto the marketing site.
# ---------------------------------------------------------------------------
INTRANET_ENABLED=true

# ---------------------------------------------------------------------------
# Supabase. Both come from Project Settings → API in the Supabase dashboard.
# The anon key is safe in a browser — row-level security is what protects the
# data. The service_role key is NOT here and must never be added: it bypasses
# every policy.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=eyJ...

# ---------------------------------------------------------------------------
# Who gets in.
#
# Any Microsoft account outside this domain is refused before a profile row is
# even created — so a guest account in the DCW tenant cannot get a foothold.
# ---------------------------------------------------------------------------
INTRANET_EMAIL_DOMAIN=dcwcost.com

# NOTE: the first admin is NOT configured here. Seed the `bootstrap_admins`
# table in Supabase before anyone signs in — see docs/team-intranet/SETUP.md
# step 3. Admin status is decided in the database on purpose, so that a leaked
# build config can never grant it.

# ---------------------------------------------------------------------------
# Data source. `fixtures` serves invented demo numbers and is the default;
# `supabase` reads the real cost library and errors until that provider is
# implemented (src/lib/intranet/data/supabase.ts).
# ---------------------------------------------------------------------------
INTRANET_DATA=fixtures
