---
import Logo from './Logo.astro';

const { pathname } = Astro.url;
const isActive = (href) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);

const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/projects', label: 'Projects' },
  { href: '/insights', label: 'Insights' },
  { href: '/careers', label: 'Careers' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="DCW Cost Management — home">
      <Logo tone="color" size={50} />
    </a>

    <!-- Real <button> (not a label-for-checkbox) so the menu is reachable by
         keyboard and announces its state. See the inline script below: the
         nav is expanded by default and only collapses once JS confirms it can
         reopen it, so a no-JS visitor still gets full navigation. -->
    <button
      type="button"
      class="nav-burger"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      <span></span><span></span><span></span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Primary">
      <ul>
        {links.map((l) => (
          <li>
            <a href={l.href} class={isActive(l.href) ? 'active' : ''}
               aria-current={isActive(l.href) ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))}
        <li class="nav-cta">
          <a href="/contact" class="btn btn-outline">Start a Conversation</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const header = document.querySelector('[data-header]');
    const toggle = header && header.querySelector('[data-nav-toggle]');
    if (!header || !toggle) return;

    const setOpen = (open) => {
      header.toggleAttribute('data-nav-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };

    toggle.addEventListener('click', () => {
      setOpen(!header.hasAttribute('data-nav-open'));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.hasAttribute('data-nav-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: saturate(180%) blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 80px;
  }
  .brand { display: flex; align-items: center; }

  .site-nav ul {
    list-style: none;
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 1.8vw, 1.75rem);
    margin: 0;
    padding: 0;
  }
  .site-nav a:not(.btn) {
    font-weight: 600;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--blue);
    padding-bottom: 4px;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
  }
  .site-nav a:not(.btn):hover { color: var(--green-ink); }
  .site-nav a.active {
    color: var(--ink);
    border-bottom-color: var(--green);
  }
  /* nav-cta is a .btn — keep its full border; no nav underline needed */

  .nav-burger { display: none; }

  @media (max-width: 960px) {
    .nav-burger {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 5px;
      width: 44px;
      height: 44px;
      padding: 0;
      background: none;
      border: 0;
      border-radius: var(--radius);
      cursor: pointer;
    }
    .nav-burger span {
      height: 2px;
      width: 26px;
      background: var(--blue);
      border-radius: 2px;
      transition: transform 0.22s ease, opacity 0.18s ease;
    }
    .nav-burger:focus-visible {
      outline: 2px solid var(--green-ink);
      outline-offset: 2px;
    }
    /* Burger morphs into an X while the menu is open. */
    .site-header[data-nav-open] .nav-burger span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .site-header[data-nav-open] .nav-burger span:nth-child(2) { opacity: 0; }
    .site-header[data-nav-open] .nav-burger span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    .site-nav {
      position: absolute;
      top: 80px;
      left: 0;
      right: 0;
      background: #fff;
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow-md);
    }
    .site-nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.5rem 0;
    }
    .site-nav li { padding: 0.55rem var(--gap); }
    .nav-cta { padding-top: 0.75rem !important; }
    .nav-cta a { display: inline-flex; }

    /* Collapsed only when JS is running to reopen it (html.js is set in
       Layout.astro's <head>, so there is no open-then-snap-shut flash). */
    :global(html.js) .site-nav {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.28s ease;
    }
    :global(html.js) .site-header[data-nav-open] .site-nav { max-height: 520px; }
  }
</style>
