---
import '../../styles/intranet.css';

export const prerender = false;

const session = Astro.locals.session;
const revoked = session?.kind === 'revoked';
const name = session && 'profile' in session ? session.profile.fullName : null;
const email = session && 'profile' in session ? session.profile.email : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{revoked ? 'Access ended' : 'Waiting for approval'} — DCW Team Intranet</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400&display=swap"
      rel="stylesheet"
    />
    <style>
      .wrap { min-height: 100vh; display: grid; place-items: center; padding: 2rem 16px; }
      .card {
        width: 100%;
        max-width: 27rem;
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: 4px;
        padding: 2rem 1.75rem;
      }
      .card h1 {
        font-family: var(--brand);
        font-weight: 800;
        text-transform: uppercase;
        font-size: 1.05rem;
        color: var(--ink);
        margin: 0 0 0.8rem;
      }
      .card p { margin: 0 0 0.9rem; font-size: 0.92rem; }
      .who {
        font-family: var(--mono);
        font-size: 0.76rem;
        color: var(--muted);
        border-left: 2px solid var(--teal);
        padding-left: 0.7rem;
        margin-bottom: 1.2rem;
        overflow-wrap: anywhere;
      }
    </style>
  </head>
  <body class="intranet">
    <div class="wrap">
      <div class="card">
        <h1>{revoked ? 'Access ended' : 'Waiting for approval'}</h1>

        {
          (name || email) && (
            <p class="who">
              {name}
              {email && <><br />{email}</>}
            </p>
          )
        }

        {
          revoked ? (
            <p>
              Your access to the cost library has been ended. If that's unexpected,
              speak to Rachel, Brian or Trish.
            </p>
          ) : (
            <>
              <p>
                You're signed in with Microsoft, and your account is waiting for an
                admin to approve it. Rachel, Brian and Trish can do that.
              </p>
              <p>
                Nothing else is visible until then — the cost data is gated in the
                database itself, not just in this interface.
              </p>
            </>
          )
        }

        <a class="btn" href="/teamintranet/auth/signout">Sign out</a>
      </div>
    </div>
  </body>
</html>
