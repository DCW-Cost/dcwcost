---
import Layout from '../layouts/Layout.astro';
import MarketIcon from '../components/MarketIcon.astro';
import { sectors } from '../data/sectors.js';

const stats = [
  { num: '2012', label: 'Founded in the PNW' },
  { num: '400+', label: 'Projects every year' },
  { num: '2', label: 'Offices — Seattle & Portland' },
  { num: '100%', label: 'Employee-Owned Trust' },
];

const pillars = [
  {
    tag: 'Cost Management',
    title: 'Numbers owners can trust — and defend.',
    body:
      'Independent, third-party cost intelligence at every phase, from the first business case through final reconciliation. No agenda but yours.',
    points: [
      'Third-party cost estimating (ICE)',
      'Design-based cost management',
      'Business-case cost planning',
      'Cost review, reporting & reconciliation',
    ],
  },
];

// Client-care commitments — Pillar 1 of DCW's 2026–2036 strategic plan
// ("client relationships are at the core of the service offering").
const care = [
  'Answers, not just numbers — we explain what sits behind every line.',
  "Prompt, direct communication — you talk to the people doing the work.",
  'Engaged past the deliverable, through the decisions it informs.',
  'One team from planning through occupancy — no handoff to a different bench.',
];

// Technology & process — Pillar 4 of the strategic plan. Deliberately describes
// method rather than naming specific tools or claiming capabilities.
// ⚠️ VERIFY BEFORE LAUNCH: confirm this framing with DCW leadership.
const systems = [
  {
    title: 'Structured workflows',
    body:
      'Consistent estimating methods and internal review across every project, so the number you get reflects our process — not just whoever prepared it.',
  },
  {
    title: 'Reporting you can compare',
    body:
      'Cost information presented the same way at every milestone, so owners can read phase against phase and see exactly what moved, and why.',
  },
  {
    title: 'Tools that earn their place',
    body:
      'We study what is available, test it for fit, and measure what it actually saves. Less manual effort means our people spend their time on judgment.',
  },
];

const process = [
  { step: '01', title: 'Understand the owner', body: 'We start with your goals, constraints, and risk tolerance — not a template.' },
  { step: '02', title: 'Set a defensible baseline', body: 'Independent estimates and a clear business case, before commitments are made.' },
  { step: '03', title: 'Steward the delivery', body: 'We track cost and scope, review change, and keep every decision transparent.' },
  { step: '04', title: 'Reconcile & report', body: 'Clear reporting at each milestone — no surprises, and a record you can stand behind.' },
];

// Client / design-partner logos (white marks, shown on a dark section).
const clients = [
  '1.png', '3.png', '4.png', '6.png', '7.png', '8.png', '9.png', '10.png',
  '11.png', '11-1.png', '12.png', '13.png', '14.png', '15.png', '16.png',
  '17.png', '18.png', '19.png', '20.png', '21.png', '22.png', '23.png',
  '24.png', '25.png', '26.png', '29.png', '2.ink_Studio-1.png',
  'AECOM.png', 'NELSON-1.png', 'MWA-1.png', 'Graham-Baba.png', 'Carleton-Hart.webp',
  'cardinal.png', 'ggn.png', 'hacker.png', 'opsis-1.png', 'place.png',
  'sera-1.png', 'shks.png', 'snohetta.png', 'szabo.png', 'Untitled-2.png',
];
---

<Layout
  title="DCW Cost Management"
  description="Drew Collaborative Works — independent, women-owned and employee-owned cost management serving Seattle and Portland since 2012. On the owner's side of the table, 400+ projects a year."
>
  <!-- ============ HERO ============ -->
  <!-- To use a real DCW photo, drop it in /public and set
       style="--hero-img:url('/your-photo.jpg')" on .hero below. -->
  <section class="hero">
    <div class="container hero-inner">
      <span class="hero-eyebrow">Independent cost management</span>
      <h1>On the owner's side, start to&nbsp;finish</h1>
      <p class="hero-lead">
        DCW is an independent, women-owned and employee-owned firm delivering
        design-based cost consulting across the Pacific Northwest. Collaboration
        is in our name — and your budget is our only agenda.
      </p>
      <div class="hero-cta">
        <a href="/services" class="btn btn-primary btn-lg">Explore our services</a>
        <a href="/projects" class="btn btn-outline on-dark btn-lg">See our work</a>
      </div>
    </div>
  </section>

  <!-- ============ STATS ============ -->
  <section class="section-blue stats-band">
    <div class="container grid grid-4">
      {stats.map((s) => (
        <div class="stat">
          <span class="num">{s.num}</span>
          <span class="label">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ INTRO ============ -->
  <section class="section">
    <div class="container section-head">
      <span class="eyebrow">Who we are</span>
      <h2 class="section-title"><strong>An owner's advocate</strong><br />at every stage.</h2>
      <p class="lead">
        DCW is an independent, women-owned cost management firm.
        We sit on the owner's side of the table — free from the interests of
        designers or contractors — so we can protect budgets, challenge
        assumptions, and preserve design intent from concept to closeout.
      </p>
    </div>
  </section>

  <!-- ============ SERVICE PILLARS ============ -->
  <section class="section section-mist">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What we do</span>
        <h2 class="section-title underline-accent">One discipline, one owner-first&nbsp;mission</h2>
      </div>
      <div class="grid" style="max-width:640px;margin-inline:auto">
        {pillars.map((p) => (
          <div class="card card-accent card-hover">
            <span class="tag">{p.tag}</span>
            <h3 style="margin-top:0.85rem">{p.title}</h3>
            <p>{p.body}</p>
            <ul class="check-list">
              {p.points.map((pt) => <li>{pt}</li>)}
            </ul>
          </div>
        ))}
      </div>
      <div class="center mt-2">
        <a href="/services" class="btn btn-primary">Explore all services</a>
      </div>
    </div>
  </section>

  <!-- ============ MORE THAN A DELIVERABLE ============ -->
  <section class="section">
    <div class="container care-inner">
      <div>
        <span class="eyebrow">Client care</span>
        <h2 class="section-title underline-accent">More than a&nbsp;deliverable</h2>
        <p>
          Our work does not end when the estimate lands in your inbox. We walk
          owners through the numbers, answer the questions behind them, and stay
          engaged through the decisions they inform.
        </p>
        <p>
          Clear, prompt communication is not a courtesy we add on top. It is how
          owners stay in control of their own projects — and it is the reason
          our clients keep bringing us the next one.
        </p>
        <a href="/contact" class="btn btn-outline mt-1">Discuss your project</a>
      </div>
      <ul class="care-list">
        {care.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </section>

  <!-- ============ PROCESS ============ -->
  <section class="section section-mist">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">How we work</span>
        <h2 class="section-title">A disciplined, owner-centered&nbsp;approach</h2>
      </div>
      <div class="grid grid-4">
        {process.map((p) => (
          <div class="process-step">
            <span class="step-num">{p.step}</span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ TECHNOLOGY & PROCESS ============ -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Technology &amp; process</span>
        <h2 class="section-title underline-accent">The systems behind the&nbsp;numbers</h2>
        <p class="lead">
          Good cost advice is not a one-off performance — it has to be
          repeatable. We invest in the workflows, data, and reporting that make
          our advice consistent, and we hold new technology to the same standard
          we hold every project cost: it earns its place by proving measurable
          value.
        </p>
      </div>
      <div class="grid grid-3">
        {systems.map((x) => (
          <div class="card card-accent card-hover">
            <h3>{x.title}</h3>
            <p>{x.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ PROJECTS BY MARKET ============ -->
  <section class="section section-mist">
    <div class="container">
      <div class="section-head center">
        <h2 class="section-title center">Projects by market</h2>
        <p class="lead mx-auto" style="text-align:center">
          We structure ourselves around our clients' sectors, so the guidance you
          get is market-based and specific. DCW works on 400+ projects a year —
          here's a sampling of where we collaborate.
        </p>
      </div>
      <div class="grid grid-4 market-grid">
        {sectors.map((s, i) => (
          <a href={`/sectors/${s.slug}`} class="market-tile" style={`--i:${i}${s.image ? `; --img: url('${s.image}')` : ''}`}>
            <MarketIcon name={s.icon} class="tile-ico" />
            <span class="market-label">{s.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CLIENTS / DESIGN PARTNERS ============ -->
  <section class="section clients-band">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow" style="color:#a9c7ff">Trusted collaborators</span>
        <h2 class="section-title center" style="color:#fff">We work with the region's leading design&nbsp;teams</h2>
      </div>
      <div class="client-grid">
        {clients.map((c) => (
          <div class="client-logo">
            <img src={`/${c}`} alt="" decoding="async" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ EMPLOYEE-OWNED TEASER ============ -->
  <section class="section section-blue eo-band">
    <div class="container eo-inner">
      <div>
        <span class="eyebrow">Employee-Owned Trust</span>
        <h2 class="section-title">Everyone here has a stake in your&nbsp;success</h2>
        <p class="lead" style="color:#dbe6f7">
          DCW is one of the first Employee Ownership Trusts in Washington — and
          still a woman-owned small business. Shared ownership means the person
          on your project is an owner too, invested in getting it right.
        </p>
        <a href="/employee-owned" class="btn btn-primary mt-1">How we're owned</a>
      </div>
      <div class="eo-quote">
        <p>&ldquo;DCW delivery of services has been excellent.&rdquo;</p>
        <cite>Johnathan Hartung<span>SHKS Architects</span></cite>
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="section cta-band center">
    <div class="container">
      <h2 class="section-title center">Let's collaborate</h2>
      <p class="lead mx-auto" style="text-align:center">
        Whether you're shaping a business case or delivering in the field, we'd
        love to help you get it right.
      </p>
      <div class="mt-2">
        <a href="/contact" class="btn btn-primary btn-lg">Request a fee proposal</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ---- Hero ---- */
  .hero {
    position: relative;
    color: #fff;
    background:
      linear-gradient(180deg, rgba(13, 27, 50, 0.66), rgba(11, 24, 46, 0.86)),
      url('/DCW-2-scaled.jpg') center / cover no-repeat,
      linear-gradient(125deg, var(--blue-900) 0%, var(--blue) 55%, var(--teal) 130%);
    padding-block: clamp(4.5rem, 12vw, 9rem);
  }
  .hero-inner { max-width: 60rem; }
  .hero-eyebrow {
    display: inline-block;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-weight: 600;
    font-size: 0.85rem;
    color: #cde0ff;
    margin-bottom: 1rem;
  }
  .hero h1 {
    color: #fff;
    font-size: clamp(2.8rem, 8vw, 6rem);
    line-height: 0.98;
    margin-bottom: 1.25rem;
  }
  .hero-lead {
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    font-weight: 400;
    color: #e6eefb;
    max-width: 52ch;
    line-height: 1.55;
    margin-bottom: 2rem;
  }
  .hero-cta { display: flex; gap: 1rem; flex-wrap: wrap; }

  /* ---- Stats ---- */
  .stats-band { padding-block: clamp(2.25rem, 4vw, 3.25rem); }

  /* ---- Check list ---- */
  .check-list {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }
  .check-list li {
    position: relative;
    padding-left: 1.7rem;
    color: var(--body);
    font-size: 0.98rem;
  }
  .check-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 0.7rem;
    height: 0.7rem;
    background: var(--green);
    border-radius: 2px;
  }

  /* ---- Process ---- */
  .step-num {
    font-weight: 800;
    font-size: 2.4rem;
    color: var(--green);
    display: block;
    line-height: 1;
    margin-bottom: 0.5rem;
  }
  .process-step h3 { font-size: 1.15rem; margin-bottom: 0.35rem; }
  .process-step p { color: var(--muted); font-size: 0.97rem; }

  /* ---- Client care ---- */
  .care-inner {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .care-list {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.5rem;
    border-left: 4px solid var(--green);
    display: grid;
    gap: 1.1rem;
  }
  .care-list li {
    font-size: 1.02rem;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.5;
  }
  @media (max-width: 820px) {
    .care-inner { grid-template-columns: 1fr; }
  }

  /* ---- Market tiles ---- */
  .market-tile {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    color: #fff;
    background:
      linear-gradient(180deg, rgba(15, 44, 88, 0.15), rgba(15, 44, 88, 0.78)),
      var(--img, linear-gradient(140deg, var(--blue) 0%, var(--blue-900) 60%, var(--teal) 130%));
    background-size: cover;
    background-position: center;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .market-tile:nth-child(even) {
    background:
      linear-gradient(180deg, rgba(15, 44, 88, 0.15), rgba(15, 44, 88, 0.80)),
      var(--img, linear-gradient(140deg, var(--teal) -20%, var(--blue) 55%, var(--blue-900) 120%));
    background-size: cover;
    background-position: center;
  }
  .market-tile:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); color: #fff; }
  /* MarketIcon renders in its own component scope, so target it globally */
  :global(.tile-ico) {
    position: absolute;
    left: 1.4rem;
    top: 1.3rem;
    width: 46px;
    height: 46px;
    color: #fff;
    opacity: 0.95;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.35));
    transition: transform 0.2s ease, opacity 0.2s ease;
    transform-origin: left top;
  }
  .market-tile:hover :global(.tile-ico) { opacity: 1; transform: scale(1.1); }
  .market-label {
    position: absolute;
    left: 1rem;
    bottom: 0.9rem;
    right: 1rem;
    font-weight: 700;
    font-size: 1.02rem;
    letter-spacing: 0.01em;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.35);
  }

  /* ---- Employee-owned band ---- */
  .eo-inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .eo-quote {
    border-left: 4px solid var(--green);
    padding-left: 1.5rem;
  }
  .eo-quote p {
    font-size: clamp(1.3rem, 2.4vw, 1.75rem);
    font-weight: 300;
    font-style: italic;
    color: #fff;
    line-height: 1.35;
    margin-bottom: 1rem;
  }
  .eo-quote cite {
    font-style: normal;
    font-weight: 700;
    color: #fff;
    display: block;
  }
  .eo-quote cite span {
    display: block;
    font-weight: 500;
    color: #a9c7ff;
    font-size: 0.9rem;
    margin-top: 0.15rem;
  }
  @media (max-width: 780px) {
    .eo-inner { grid-template-columns: 1fr; }
  }

  .cta-band { background: var(--mist-2); }

  /* ---- Client / partner logo wall ----
     All supplied marks are white-on-transparent, so they sit on a dark
     panel with no color filter. */
  .clients-band { background: var(--blue-900); }
  .client-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem) clamp(1rem, 2.5vw, 2rem);
    align-items: center;
  }
  .client-logo {
    display: grid;
    place-items: center;
    height: 60px;
  }
  .client-logo img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    object-fit: contain;
    opacity: 0.9;
    transition: opacity 0.18s ease;
  }
  .client-logo:hover img { opacity: 1; }
</style>
