---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import MarketIcon from '../components/MarketIcon.astro';
import { projects, featuredProjects } from '../data/projects.js';
import { sectors } from '../data/sectors.js';

const featured = featuredProjects()[0];
const rest = projects.filter((p) => p.slug !== featured.slug);
---

<Layout
  title="Projects"
  description="DCW delivers independent cost management across government, healthcare, education, parks, ports, transportation, and more — including Colman Dock for Washington State Ferries."
>
  <PageHeader
    eyebrow="Projects"
    title="Owner-centered work across the sectors that matter"
    lead="From landmark marine terminals to schools, campuses, and public infrastructure, DCW helps owners deliver with confidence — more than 400 projects every year."
  />

  <!-- ---- Featured case study ---- -->
  <section class="section">
    <div class="container featured">
      <div class="featured-media">
        <img src={featured.image} alt="" loading="lazy" decoding="async" />
        <span class="tag">{featured.sector}</span>
      </div>
      <div class="featured-body">
        <span class="eyebrow">Featured case study</span>
        <h2 class="section-title"><strong>{featured.name}</strong><br />{featured.subtitle}</h2>
        <p class="client-line"><strong>Client:</strong> {featured.client}</p>
        <p>{featured.summary}</p>
        <a href={`/projects/${featured.slug}`} class="btn btn-primary mt-1">Read the case study</a>
      </div>
    </div>
  </section>

  <!-- ---- Case-study library ---- -->
  <section class="section section-mist">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Selected projects</span>
        <h2 class="section-title underline-accent">A sample of our&nbsp;work</h2>
      </div>
      <div class="grid grid-3">
        {rest.map((p) => (
          <a href={`/projects/${p.slug}`} class="card card-accent card-hover proj-link">
            <span class="tag">{p.sector}</span>
            <h3 style="margin-top:0.7rem">{p.name}</h3>
            <p class="proj-client">{p.client}</p>
            <p>{p.summary}</p>
            <span class="proj-more">Read the case study →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ---- Sectors ---- -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Markets we serve</span>
        <h2 class="section-title underline-accent">Deep experience across public &amp; institutional&nbsp;sectors</h2>
        <p class="lead">
          DCW brings the same independent, owner-first discipline to every market
          we work in — giving owners cost clarity from first business case through
          closeout. Explore a sector to see how we help.
        </p>
      </div>
      <div class="grid grid-4 market-cards">
        {sectors.map((s) => (
          <a href={`/sectors/${s.slug}`} class="card card-accent card-hover sector-card">
            <MarketIcon name={s.icon} class="mc-ico" />
            <h3>{s.name}</h3>
            <p>{s.tagline}</p>
            <span class="proj-more">Explore {s.name} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ---- CTA ---- -->
  <section class="section section-blue center">
    <div class="container">
      <h2 class="section-title center">Have a project in one of these sectors?</h2>
      <p class="lead mx-auto" style="text-align:center;color:#dbe6f7">
        We'd welcome the chance to talk through how DCW can support your next
        civic, transit, or public project.
      </p>
      <div class="mt-2">
        <a href="/contact" class="btn btn-primary btn-lg">Request a fee proposal</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .featured {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }
  @media (max-width: 820px) { .featured { grid-template-columns: 1fr; } }
  .featured-media {
    position: relative;
    aspect-ratio: 16 / 11;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: linear-gradient(140deg, var(--blue) 0%, var(--blue-900) 60%, var(--teal) 130%);
    box-shadow: var(--shadow-md);
  }
  .featured-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .featured-media .tag { position: absolute; top: 1rem; left: 1rem; z-index: 1; background: #fff; color: var(--blue); }
  .featured-body h2 { margin-bottom: 0.5rem; }
  .client-line { color: var(--muted); font-size: 0.95rem; margin-bottom: 1rem; }
  .client-line strong { color: var(--blue); }

  .proj-link { display: block; color: inherit; }
  .proj-link:hover { color: inherit; }
  .proj-client { color: var(--muted); font-size: 0.9rem; margin-bottom: 0.6rem; }
  .proj-more { color: var(--green-ink); font-weight: 700; font-size: 0.9rem; }

  .market-cards h3 { font-size: 1.15rem; }
  .market-cards p { color: var(--muted); font-size: 0.95rem; margin: 0 0 0.75rem; }
  .sector-card { display: block; color: inherit; }
  .sector-card:hover { color: inherit; }
  :global(.mc-ico) { width: 40px; height: 40px; color: var(--blue); margin-bottom: 0.85rem; }
</style>
