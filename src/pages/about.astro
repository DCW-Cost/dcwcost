---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';

const founder = {
  name: 'Trish Drew',
  creds: 'CPE, LEED AP',
  role: 'Founder & Board Chair',
  img: '/Trish-Headshot-High-Resolution-1-1024x683-square-34eaeb1b40ddf1d2aa0a4a9061ff3daa-d0qt9g4pful2.jpg',
  bio: [
    'Trish founded DCW in 2012 in response to a growing need for construction-focused cost planning and truly independent project advisory services, and began delivering project work the following year. With more than 30 years in the construction industry and over 20 in construction management, she has built a reputation for helping owners, architects, engineers, and contractors navigate complex projects with confidence.',
    'She built the firm on a simple belief: informed decision-making, collaboration, and proactive cost management are what make projects succeed. Trish led DCW’s transition to an Employee Ownership Trust and continues to shape its future as Board Chair.',
  ],
};

// ⚠️ VERIFY BEFORE LAUNCH — the roster and titles below need confirmation
// against DCW's current org chart. Public records indicate leadership is
// Trish Drew (Founder/Trustee) and Tim Ausink (Managing Director), plus team
// members including Cesar López, Xandra Egge, and Hilori. Only Trish, Rachel
// Quimby, and Ryan Fouts are clearly corroborated. Replace names, titles, and
// headshots with DCW-supplied facts — do not ship placeholders.
const team = [
  { name: 'Brian Thompson', role: 'Chief Executive Officer', img: '/Brian-Thompson-Headshot-1024x1024-square-77ac59ebe6bdd60827c1b026315e2262-0rjw5kvmza26.jpg', note: 'Leading DCW into its next phase of growth.' },
  { name: 'Rachel Quimby', role: 'Associate Director, Systems & Innovation', img: '/Rachel-2-Web-Res-square-1024x1024-square-228102f8509bbbf222b246fba59cc06b-63bdweuo4s9i.jpg', note: 'Our longest-serving team member, building the data-driven processes that keep every project efficient.' },
  { name: 'Preeti Pustake', role: 'Senior Cost Manager', img: '/preeti-pustake-web-1024x1024-square-7c8e193052ea612d2b81bba930726ddc-d4wxh5r9msgu.jpg', note: 'A background in construction management and architectural design gives her deep insight on every project.' },
  { name: 'Charu Ghadge', role: 'Senior Cost Manager', img: '/Charu-square-headshot-square-221b8d515778edb4fbeb56a23988ab9f-1748ptbwneqc.png', note: 'Civil engineering and construction expertise paired with sharp financial acumen.' },
  { name: 'Matt Thompson', role: 'Senior Cost Manager', img: '/Matt-Headshot-square-2d148b755c26c11afa4b6b0960bdc5b9-nf60wp9s3vtj.jpg', note: 'Detailed, defensible estimating across complex public and private work.' },
  { name: 'Ryan Fouts', role: 'Senior Associate', img: '/Ryan-3-High-Res-1024x731-square-1b707c6a187a966aecdfa6ad0cfb6184-1g3iaqow9rvb.jpg', note: 'Owner-side cost and project support from planning through delivery.' },
  { name: 'Katya Gamarnik', role: 'Senior Associate', img: '/Katya-1000x667-size-square-b5e621f9fd69bda2be46a233ae07cbde-cymxklq7tv5z.png', note: 'Rigorous cost analysis that keeps budgets and design intent aligned.' },
  { name: 'Brittany Gelleri', role: 'Client Relations Manager', img: '/Brittany-Landscape-Headshot-2026-1024x683-square-8443a2492b07b7292f81379489a354f8-unqho86ejx15.jpg', note: 'The connection point that keeps our clients informed and supported.' },
];

const values = [
  { title: 'Independent', body: 'We answer only to the owner — never the designer or contractor. That independence is the foundation of everything we do.' },
  { title: 'Collaborative', body: 'Collaboration is in our name. We work alongside your team to align budget, schedule, and design goals from day one.' },
  { title: 'Transparent', body: 'Honest numbers and clear reporting at every milestone mean owners are never surprised by their own project.' },
];
---

<Layout
  title="About"
  description="DCW Cost Management is an independent, woman-owned and employee-owned cost management firm founded in 2012 by Trish Drew, CPE, LEED AP."
>
  <PageHeader
    eyebrow="About DCW"
    title="Learn more about us & meet the team"
    lead="We are an independent, women-owned third-party consultancy serving owners across the Pacific Northwest — critical thinkers who prioritize your best interests at every step."
  />

  <!-- ---- Who we are ---- -->
  <section class="section">
    <div class="container about-intro">
      <div>
        <span class="eyebrow">Who we are</span>
        <h2 class="section-title"><strong>Owner-centered,</strong><br />by design.</h2>
        <p>
          We are an independent, women-owned third-party consultancy providing
          cost management and project management services from offices in
          Seattle, Washington and Portland, Oregon. Our clients include
          architects, government agencies, municipalities, non-profits, and
          commercial developers.
        </p>
        <p>
          We deliver market-based, independent cost consultancy, geared toward
          preserving design intent and owner requirements. From planning through
          occupancy, we prioritize your best interests at every step of the
          process.
        </p>
        <div class="badges">
          <span class="badge">Woman-Owned</span>
          <span class="badge">WBE Certified</span>
          <span class="badge">WOSB Certified</span>
          <span class="badge">Employee-Owned Trust</span>
        </div>
      </div>
      <div class="about-photo">
        <img src="/DCW-2-scaled.jpg" alt="The DCW team collaborating" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  <!-- ---- Founder ---- -->
  <section class="section section-blue">
    <div class="container founder">
      <div class="founder-photo">
        <img src={founder.img} alt={founder.name} loading="lazy" decoding="async" />
      </div>
      <div class="founder-body">
        <span class="eyebrow">Founder</span>
        <h2>{founder.name}<span class="creds">, {founder.creds}</span></h2>
        <p class="founder-role">{founder.role}</p>
        {founder.bio.map((para) => <p>{para}</p>)}
      </div>
    </div>
  </section>

  <!-- ---- Team ---- -->
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">The team</span>
        <h2 class="section-title center">Critical thinkers & collaborators</h2>
      </div>
      <div class="grid grid-4 team-grid">
        {team.map((m) => (
          <div class="member">
            <div class="member-photo">
              <img src={m.img} alt={m.name} loading="lazy" decoding="async" />
            </div>
            <h3>{m.name}</h3>
            <p class="member-role">{m.role}</p>
            <p class="member-note">{m.note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ---- Values ---- -->
  <section class="section section-mist">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What guides us</span>
        <h2 class="section-title underline-accent">Principles that hold across every&nbsp;project</h2>
      </div>
      <div class="grid grid-3">
        {values.map((v) => (
          <div class="card card-accent card-hover">
            <h3>{v.title}</h3>
            <p>{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .about-intro {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  @media (max-width: 820px) { .about-intro { grid-template-columns: 1fr; } }

  .about-photo {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }
  .about-photo img { width: 100%; height: 100%; object-fit: cover; }

  .badges { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.75rem; }
  .badge {
    background: var(--blue);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
  }

  /* Founder */
  .founder {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  .founder-photo {
    aspect-ratio: 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: rgba(255, 255, 255, 0.12);
  }
  .founder-photo img { width: 100%; height: 100%; object-fit: cover; }
  .founder-body h2 { color: #fff; margin-bottom: 0.15rem; }
  .founder-body .creds { font-weight: 400; color: #a9c7ff; }
  .founder-role {
    color: var(--green);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.85rem;
    margin-bottom: 1.25rem;
  }
  .founder-body p { color: #dbe6f7; }
  @media (max-width: 620px) { .founder { grid-template-columns: 1fr; } .founder-photo { max-width: 220px; } }

  /* Team */
  .member-photo {
    aspect-ratio: 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: 0.9rem;
    background: linear-gradient(140deg, var(--blue), var(--blue-900));
  }
  .member-photo img { width: 100%; height: 100%; object-fit: cover; }
  .member h3 { font-size: 1.1rem; margin-bottom: 0.1rem; }
  .member-role {
    color: var(--blue);
    font-weight: 700;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.5rem;
  }
  .member-note { color: var(--muted); font-size: 0.92rem; }
</style>
