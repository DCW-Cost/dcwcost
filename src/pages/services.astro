---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { sectors } from '../data/sectors.js';

const costServices = [
  { title: 'Third-Party Cost Estimation (ICE)', body: 'Budget and estimate validation using independent third-party cost estimating — accounting for soft costs, relocation, and other owner expenditures.' },
  { title: 'Design-Based Cost Management', body: 'Cost intelligence embedded through every design phase, so budgets and design decisions stay aligned before changes get expensive.' },
  { title: 'Business Case Cost Planning', body: 'Early-stage planning that turns a concept into a fundable business case owners can take forward with confidence.' },
  { title: 'Feasibility Studies', body: 'Early cost and viability analysis that tests whether a concept pencils out — before an owner commits real money to it.' },
  { title: 'Life-Cycle Cost Analysis & O&M', body: 'Whole-life cost analysis (LCCA) that weighs operations, maintenance, energy, and replacement — so owners choose what is cheapest to own, not just to build.' },
  { title: 'Cost Review & Reporting', body: 'Ongoing review and transparent reporting that keep every stakeholder aligned on where the budget stands.' },
  { title: 'Master Planning & Pre-Design', body: 'Cost guidance at the earliest stages, shaping scope and program against a realistic, market-based budget.' },
  { title: 'Reconciliation Management', body: 'Structured reconciliation between parties and phases — resolving differences before they become disputes.' },
];

---

<Layout
  title="Services"
  description="DCW Cost Management delivers independent cost management — third-party estimating, cost planning, life-cycle cost analysis, cost review and reporting, and more."
>
  <PageHeader
    eyebrow="Services"
    title="Expertise built for your project"
    lead="Our collaborative team addresses your project with agility and flexibility, and our tailored services mean we can support you no matter the scope."
  />

  <!-- ---- Intro + testimonial ---- -->
  <section class="section">
    <div class="container svc-intro">
      <div>
        <h2 class="section-title"><strong>Personalized</strong><br />cost management</h2>
        <p class="lead">
          We're proud of a strong reputation for service — with clients who
          regularly recommend us and our work. We tailor our independent cost
          intelligence to the scope of your project, at every phase.
        </p>
      </div>
      <blockquote class="svc-quote">
        <p>&ldquo;DCW delivery of services has been excellent.&rdquo;</p>
        <cite>Johnathan Hartung<span>SHKS Architects</span></cite>
      </blockquote>
    </div>
  </section>

  <!-- ---- Service columns ---- -->
  <section class="section section-blue">
    <div class="container">
      <div class="svc-columns-single">
        <div>
          <h2 class="svc-col-title">Cost Management Services</h2>
          <div class="svc-list">
            {costServices.map((s) => (
              <details class="svc-item">
                <summary>{s.title}</summary>
                <p>{s.body}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ---- Service markets ---- -->
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <h2 class="section-title center">Service markets</h2>
        <p class="lead mx-auto" style="text-align:center">
          We structure ourselves around our clients' sectors to provide
          industry-relevant, market-based advice — a level of understanding that
          inspires cost confidence and sets us apart.
        </p>
      </div>
      <ul class="market-check grid grid-4">
        {sectors.map((s) => (
          <li>
            <a href={`/sectors/${s.slug}`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg>
              {s.name}
            </a>
          </li>
        ))}
      </ul>
      <div class="center mt-2">
        <a href="/projects" class="btn btn-outline">Browse projects by market</a>
      </div>
    </div>
  </section>

  <!-- ---- CTA ---- -->
  <section class="section section-mist center">
    <div class="container">
      <h2 class="section-title center">Not sure which service you need?</h2>
      <p class="lead mx-auto" style="text-align:center">
        Tell us about your project and we'll help you scope the right cost
        support — at whatever phase you're in.
      </p>
      <div class="mt-2">
        <a href="/contact" class="btn btn-primary btn-lg">Start a conversation</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .svc-intro {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  @media (max-width: 820px) { .svc-intro { grid-template-columns: 1fr; } }
  .svc-quote {
    margin: 0;
    border-left: 4px solid var(--green);
    padding-left: 1.5rem;
  }
  .svc-quote p {
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    font-weight: 300;
    font-style: italic;
    color: var(--ink);
    line-height: 1.35;
    margin-bottom: 0.85rem;
  }
  .svc-quote cite { font-style: normal; font-weight: 700; color: var(--blue); }
  .svc-quote cite span { display: block; font-weight: 500; color: var(--muted); font-size: 0.88rem; margin-top: 0.15rem; }

  .svc-columns-single {
    max-width: 720px;
    margin-inline: auto;
  }
  .svc-col-title {
    color: #fff;
    padding-bottom: 0.85rem;
    margin-bottom: 1.25rem;
    border-bottom: 4px solid var(--green);
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
  }
  .svc-list { display: grid; gap: 0.75rem; }
  .svc-item {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--radius);
    padding: 0.9rem 1.1rem;
  }
  .svc-item summary {
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    color: #fff;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .svc-item summary::-webkit-details-marker { display: none; }
  .svc-item summary::after {
    content: "+";
    font-weight: 400;
    font-size: 1.4rem;
    line-height: 1;
    color: var(--green);
  }
  .svc-item[open] summary::after { content: "\2212"; }
  .svc-item p { margin: 0.75rem 0 0; color: #cfe0f7; font-size: 0.95rem; }

  .market-check {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .market-check li { padding: 0; }
  .market-check a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    color: var(--ink);
    padding: 0.6rem 0;
  }
  .market-check a:hover { color: var(--green-ink); }
  .market-check svg { width: 22px; height: 22px; color: var(--green); flex: 0 0 auto; }
</style>
