---
import IntranetLayout from '../../../layouts/IntranetLayout.astro';
import { provider } from '../../../lib/intranet/data/index.ts';

export const prerender = false;

const estimates = await provider.listEstimates();
---

<IntranetLayout title="Estimate Builder" crumb="Estimate Builder" section="estimates">
  <div class="pane">
    <p class="lede">
      Drop in the client's requirements and your own working files, and get back a
      populated cost plan scoped to what the project actually asks for — editable,
      in DCW's own template.
    </p>

    <div class="vbox amber-box" id="builder-note">
      <span class="dot" style="background:var(--hold)"></span>
      <div>
        <b>Starting a new estimate does not work yet</b>
        The screens below are real, but they run on demo data and the builder itself is
        designed rather than built — so the button is switched off instead of pretending.
        What comes first is getting real cost plans in:
        <a href="/teamintranet/documents/">add a document</a>, and answer whatever the reader
        asks. If the order of that is wrong, say so on the
        <a href="/teamintranet/wishlist/">Wishlist</a>.
      </div>
    </div>

    <div class="card">
      <div class="card-head">
        <h3>In progress</h3>
        <!--
          Honestly disabled rather than silently dead. The Estimate Builder is
          designed but not built, and a button that looks live and does nothing
          costs more trust than a button that says why it is off.
        -->
        <button
          class="btn primary"
          type="button"
          disabled
          title="The Estimate Builder is not built yet — see the note below"
          aria-describedby="builder-note"
        >
          New estimate
        </button>
      </div>
      {
        estimates.length ? (
          <div class="tbl-wrap">
            <table class="data" style="min-width:600px">
              <thead>
                <tr>
                  <th>Project</th>
                  <th style="width:9rem">Status</th>
                  <th style="width:10rem">Owner</th>
                  <th style="width:9rem">Updated</th>
                </tr>
              </thead>
              <tbody>
                {estimates.map((e) => (
                  <tr>
                    <td>
                      <a class="code" href={`/teamintranet/estimates/${e.id}/`}>
                        {e.name}
                      </a>
                    </td>
                    <td>{e.status}</td>
                    <td>{e.createdByName}</td>
                    <td class="num">
                      {new Date(e.updatedAt).toLocaleDateString('en-US', {
                        month: 'short',
                        day: 'numeric',
                      })}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <div class="empty-state">No estimates yet.</div>
        )
      }
    </div>

    <div class="card">
      <div class="card-head"><h3>How it works</h3></div>
      <div class="card-body">
        <p class="note-serif" style="margin:0 0 .7rem;max-width:64ch">
          The same reader that learned from DCW's archive, pointed forward. It reads
          the RFP, the program document and the drawing set to work out what this
          project needs, then proposes a rate for each element from comparable
          history — escalated to your construction midpoint.
        </p>
        <p class="note-serif" style="margin:0;max-width:64ch">
          Elements it can't price confidently arrive <strong>blank</strong>, with the
          reason attached. A blank prompts an estimator; a confidently wrong number
          reaches a client with your name on it.
        </p>
      </div>
    </div>
  </div>
</IntranetLayout>

<style>
  .vbox {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 0.75rem 0.9rem;
    border: 1px solid;
    border-radius: 3px;
    margin-bottom: 1rem;
  }
  .vbox .dot { width: 11px; height: 11px; border-radius: 50%; flex: none; margin-top: 0.36rem; }
  .vbox b {
    font-family: var(--brand);
    font-weight: 700;
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.15rem;
  }
  .vbox div { font-size: 0.85rem; color: var(--body); }
  .amber-box { background: var(--hold-bg); border-color: var(--hold-line); }
  .btn:disabled { opacity: 0.55; cursor: not-allowed; }
  .btn:disabled:hover { border-color: var(--line-2); color: var(--body); }
</style>
